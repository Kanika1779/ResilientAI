# Copy to .env and fill in. Never commit .env.

# Two or more provider keys, comma-separated. Exposed only as key_1, key_2, ...
# For Gemini, create each key in a DIFFERENT Google Cloud project; keys in the
# same project share one quota, so a real 429 would hit both.
LLM_API_KEYS=your_first_key_here,your_second_key_here

# Any LiteLLM model string supported by the keys above. flash-lite is fast (~1-2 s)
# and light on free-tier quota; larger models can be slow or overloaded (503).
MODEL_NAME=gemini/gemini-3.5-flash-lite

# SQLite file inside the Docker volume.
DATABASE_URL=sqlite:////data/app.db

# Comma-separated list of frontend origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:3000
# Optional regex for extra origins, e.g. Vercel previews: https://resilientai-.*\.vercel\.app
ALLOWED_ORIGIN_REGEX=

# Enables the X-Simulate-Failure test header.
ENABLE_FAILURE_SIMULATION=true

# Default system prompt (a request's system_prompt overrides it for that session).
DEFAULT_SYSTEM_PROMPT=You are a helpful, concise AI assistant.
# Per-key request timeout before failing over to the next key.
LLM_TIMEOUT_SECONDS=30
# How long cached replies live (in-memory, cleared on restart).
CACHE_TTL_SECONDS=86400

# Frontend build only: where the browser reaches the backend.
VITE_API_URL=http://localhost:8000
